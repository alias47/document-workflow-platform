# =============================================================================
# EduFlow — Document Workflow Platform
# Copy this file to .env and fill in the values for your local environment.
# Copy to .env.local to override specific values without modifying .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
API_PREFIX=api
API_VERSION=v1

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# PostgreSQL connection string. Start the database with:
#   docker compose -f docker/docker-compose.yml up -d
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/document_workflow"

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
# Provider for uploaded document files. Only `local` is supported in the MVP;
# R2/S3 land post-pilot via the StorageProvider interface (no code changes).
STORAGE_PROVIDER=local
# Root directory for local file storage (relative to the API working directory).
STORAGE_LOCAL_ROOT=storage
# Maximum accepted upload size in bytes (default 10 MiB).
STORAGE_MAX_FILE_SIZE_BYTES=10485760

# -----------------------------------------------------------------------------
# Frontend (Next.js)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
