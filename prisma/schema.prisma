generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum StaffStatus {
  active
  inactive
  suspended
}

enum PortalAccountStatus {
  pending
  invitation_sent
  invitation_accepted
  active
  suspended
  disabled
  locked
}

// Applicant lifecycle status. Domain doc §9 defines "Current Status" generically;
// values kept industry-neutral (no Student/Candidate terms leak into the backend).
enum ApplicantStatus {
  active
  inactive
  archived
}

// ---------------------------------------------------------------------------
// ORGANIZATION
// ---------------------------------------------------------------------------

model Organization {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  legalName    String?
  slug         String    @unique
  contactEmail String
  contactPhone String?
  website      String?
  country      String?
  timezone     String    @default("UTC")
  industryType String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  staff       Staff[]
  roles       Role[]
  applicants  Applicant[]
  assignments ApplicantAssignment[]

  @@map("organizations")
}

// ---------------------------------------------------------------------------
// ROLE
// ---------------------------------------------------------------------------

model Role {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  description    String?
  isDefault      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization     @relation(fields: [organizationId], references: [id])
  staff        Staff[]
  permissions  RolePermission[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

// ---------------------------------------------------------------------------
// PERMISSION
// ---------------------------------------------------------------------------

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  action      String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ---------------------------------------------------------------------------
// STAFF
// ---------------------------------------------------------------------------

model Staff {
  id                String      @id @default(uuid()) @db.Uuid
  organizationId    String      @db.Uuid
  roleId            String      @db.Uuid
  firstName         String
  lastName          String
  email             String
  phone             String?
  jobTitle          String?
  profileImage      String?
  status            StaffStatus @default(active)
  passwordHash      String
  lastLoginAt       DateTime?
  failedAttempts    Int         @default(0)
  lockedUntil       DateTime?
  mustChangePass    Boolean     @default(false)
  passwordChangedAt DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  deletedAt         DateTime?

  organization        Organization          @relation(fields: [organizationId], references: [id])
  role                Role                  @relation(fields: [roleId], references: [id])
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  assignments         ApplicantAssignment[] @relation("AssignedStaff")
  assignmentsMade     ApplicantAssignment[] @relation("AssignedByStaff")

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([email])
  @@map("staff")
}

// ---------------------------------------------------------------------------
// REFRESH TOKEN
// ---------------------------------------------------------------------------

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  staffId    String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?   @db.Uuid
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// PASSWORD RESET TOKEN
// ---------------------------------------------------------------------------

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  staffId   String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// AUDIT LOG
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  actorId        String?  @db.Uuid
  actorType      String   @default("staff")
  action         String
  resourceType   String?
  resourceId     String?  @db.Uuid
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// PORTAL ACCOUNT (applicant auth — scaffold for future sprint)
// ---------------------------------------------------------------------------

model PortalAccount {
  id                  String              @id @default(uuid()) @db.Uuid
  organizationId      String              @db.Uuid
  applicantId         String?             @unique @db.Uuid
  email               String
  passwordHash        String?
  status              PortalAccountStatus @default(pending)
  invitationToken     String?             @unique
  invitationExpiresAt DateTime?
  activatedAt         DateTime?
  failedAttempts      Int                 @default(0)
  lockedUntil         DateTime?
  mustChangePass      Boolean             @default(true)
  passwordChangedAt   DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  deletedAt           DateTime?

  applicant Applicant? @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([email])
  @@index([invitationToken])
  @@map("portal_accounts")
}

// ---------------------------------------------------------------------------
// APPLICANT (domain doc §9, DB design §13.1)
// ---------------------------------------------------------------------------

model Applicant {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @db.Uuid
  applicantNumber String          @unique
  firstName       String
  middleName      String?
  lastName        String
  gender          String?
  dateOfBirth     DateTime?       @db.Date
  nationality     String?
  email           String?
  phone           String?
  address         String?
  city            String?
  country         String?
  status          ApplicantStatus @default(active)
  createdAt       DateTime        @default(now())
  createdBy       String?         @db.Uuid
  updatedAt       DateTime        @updatedAt
  updatedBy       String?         @db.Uuid
  deletedAt       DateTime?
  deletedBy       String?         @db.Uuid

  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  portalAccount PortalAccount?
  assignments   ApplicantAssignment[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([applicantNumber])
  @@index([status])
  @@index([lastName])
  @@index([email])
  @@index([organizationId, status])
  @@map("applicants")
}

// ---------------------------------------------------------------------------
// APPLICANT ASSIGNMENT (domain doc §11, DB design §13.3)
// ---------------------------------------------------------------------------

model ApplicantAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  applicantId    String   @db.Uuid
  staffId        String   @db.Uuid
  assignedBy     String?  @db.Uuid
  assignedAt     DateTime @default(now())
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  applicant       Applicant    @relation(fields: [applicantId], references: [id], onDelete: Restrict)
  staff           Staff        @relation("AssignedStaff", fields: [staffId], references: [id], onDelete: Restrict)
  assignedByStaff Staff?       @relation("AssignedByStaff", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@index([applicantId])
  @@index([staffId])
  @@index([organizationId])
  @@map("applicant_assignments")
}
