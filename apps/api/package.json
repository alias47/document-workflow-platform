{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "lint": "pnpm -w exec eslint apps/api/src --no-warn-ignored --max-warnings 0",
    "type-check": "tsc --noEmit",
    "db:generate": "dotenv -e ../../.env -- prisma generate --schema=../../prisma/schema.prisma",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev --schema=../../prisma/schema.prisma",
    "db:migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy --schema=../../prisma/schema.prisma",
    "db:seed": "dotenv -e ../../.env -- ts-node --project tsconfig.json ../../prisma/seed.ts",
    "db:studio": "dotenv -e ../../.env -- prisma studio --schema=../../prisma/schema.prisma",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:integration": "dotenv -e ../../.env -- jest --config jest.integration.config.ts --runInBand",
    "test:e2e": "dotenv -e ../../.env -- jest --config jest.e2e.config.ts --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "6.19.3",
    "@repo/config": "workspace:*",
    "@repo/types": "workspace:*",
    "@types/archiver": "^8.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/passport-jwt": "^4.0.1",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "exceljs": "^4.4.0",
    "helmet": "^8.2.0",
    "joi": "^17.13.3",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "^9.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.22",
    "@repo/eslint-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/ms": "^2.1.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.20.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.0.0",
    "jest": "^30.4.2",
    "pino-pretty": "^13.1.3",
    "prisma": "6.19.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
