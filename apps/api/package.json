{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "lint": "pnpm -w exec eslint apps/api/src --no-warn-ignored --max-warnings 0",
    "type-check": "tsc --noEmit",
    "db:generate": "dotenv -e ../../.env -- prisma generate --schema=../../prisma/schema.prisma",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev --schema=../../prisma/schema.prisma",
    "db:migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy --schema=../../prisma/schema.prisma",
    "db:seed": "dotenv -e ../../.env -- ts-node --project tsconfig.json ../../prisma/seed.ts",
    "db:studio": "dotenv -e ../../.env -- prisma studio --schema=../../prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "joi": "^17.13.3",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "6.19.3",
    "@repo/config": "workspace:*",
    "@repo/types": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@repo/eslint-config": "workspace:*",
    "eslint": "^9.0.0",
    "@repo/tsconfig": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "dotenv-cli": "^8.0.0",
    "prisma": "6.19.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
