# Copy to .env.local for local development. Only NEXT_PUBLIC_* vars are exposed
# to the browser — never put secrets here.

# Base URL of the NestJS API, including the /api/v1 version prefix.
# Services call paths relative to this (e.g. /auth/login, /applicants).
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Branding / runtime
NEXT_PUBLIC_APP_NAME=EduFlow
NEXT_PUBLIC_ENV=development
